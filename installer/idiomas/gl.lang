# ── Zona de perigo: desinstalación ───────────────────────────────────
desinst.titulo = ⚠️  Zona de perigo
desinst.intro = Estas accións desfán a instalación e non se poden desfacer. Cada unha é independente: podes desinstalar só File Browser ou só LAMP sen tocar o resto de Piztu.
desinst.confirmar.label = Escribe %s para confirmar

desinst.piztu.card = 🗑️  Desinstalar Piztu completo
desinst.piztu.desc = Elimina /opt/piztu (configuración, base de datos de posicións, historial…), salt-master e as súas chaves, o servizo de historial de sesións, a regra sudoers e a clave SSH configurada, os datos locais de Tao (~/.config/dixitalizacion) e os accesos directos e a icona. NON toca LAMP nin File Browser: desinstálaos á parte se tamén os queres eliminar.
desinst.piztu.palabra = DESINSTALAR
desinst.piztu.btn = 🗑️  Desinstalar Piztu completo
desinst.piztu.confirm = Isto vai eliminar Piztu por completo deste servidor, incluída a base de datos de posicións e o historial. Non se pode desfacer. Continuar?
desinst.piztu.erro = \n❌ Erro: %s
desinst.piztu.ok = \n✅ Piztu desinstalado completamente.

desinst.fb.card = 📁 Desinstalar File Browser
desinst.fb.desc = Elimina o servizo, o binario e a configuración de File Browser, TODOS os datos do servidor (/var/www/html/arquivos: traballos e certificados do alumnado, historial de sesións, materias, tarefas, prácticas, mensaxes…) e os datos locais de Tao deste equipo (~/.config/dixitalizacion). Non se conserva nada.
desinst.fb.btn = 📁 Desinstalar File Browser
desinst.fb.confirm = Isto vai desinstalar File Browser e BORRAR todos os seus datos: os traballos e certificados do alumnado (/var/www/html/arquivos), o historial de sesións, as materias, tarefas e prácticas, e os datos locais de Tao deste equipo (~/.config/dixitalizacion). NON se pode desfacer. Continuar?
desinst.fb.erroplaybook = ❌ Playbook non atopado: %s
desinst.fb.log.iniciando = 📁 Desinstalando File Browser…\n
desinst.fb.erro = \n❌ Erro: %s
desinst.fb.datoslocais = 🧭 Eliminando os datos locais de Tao (%s)…
desinst.fb.ok = \n✅ File Browser desinstalado.

desinst.lamp.card = 🌐 Desinstalar LAMP
desinst.lamp.desc = Elimina Apache, MariaDB e PHP deste servidor, incluídas todas as bases de datos de MySQL/MariaDB. Non toca File Browser nin os seus datos.
desinst.lamp.btn = 🌐 Desinstalar LAMP
desinst.lamp.confirm = Isto vai desinstalar Apache, MariaDB e PHP, incluídas TODAS as bases de datos. Non se pode desfacer. Continuar?
