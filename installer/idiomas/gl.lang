filebrowser.erro = \n❌ Erro: %s
filebrowser.ok = \n✅ File Browser instalado! Accede en http://localhost:8080 co usuario "%s".
filebrowser.log.grupo = ⚠️  "%s" engadiuse ao grupo www-data (para ler as sesións de Tao). Pecha sesión e volve entrar (ou reinicia) para que colla efecto.
