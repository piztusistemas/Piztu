# ── Danger zone: uninstall ───────────────────────────────────────────
desinst.titulo = ⚠️  Danger zone
desinst.intro = These actions undo the installation and cannot be reverted. Each one is independent: you can uninstall just File Browser or just LAMP without touching the rest of Piztu.
desinst.confirmar.label = Type %s to confirm

desinst.piztu.card = 🗑️  Uninstall Piztu completely
desinst.piztu.desc = Removes /opt/piztu (configuration, position database, history…), salt-master and its keys, the session history service, the sudoers rule and the configured SSH key, the local Tao data (~/.config/dixitalizacion), and the shortcuts and icon. Does NOT touch LAMP or File Browser: uninstall them separately if you also want to remove them.
desinst.piztu.palabra = UNINSTALL
desinst.piztu.btn = 🗑️  Uninstall Piztu completely
desinst.piztu.confirm = This will remove Piztu completely from this server, including the position database and history. It cannot be undone. Continue?
desinst.piztu.erro = \n❌ Error: %s
desinst.piztu.ok = \n✅ Piztu fully uninstalled.

desinst.fb.card = 📁 Uninstall File Browser
desinst.fb.desc = Removes the File Browser service, binary and configuration, ALL server data (/var/www/html/arquivos: student work and certificates, session history, subjects, assignments, practicals, messages…) and this machine's local Tao data (~/.config/dixitalizacion). Nothing is kept.
desinst.fb.btn = 📁 Uninstall File Browser
desinst.fb.confirm = This will uninstall File Browser and DELETE all its data: student work and certificates (/var/www/html/arquivos), the session history, subjects, assignments and practicals, and this machine's local Tao data (~/.config/dixitalizacion). This CANNOT be undone. Continue?
desinst.fb.erroplaybook = ❌ Playbook not found: %s
desinst.fb.log.iniciando = 📁 Uninstalling File Browser…\n
desinst.fb.erro = \n❌ Error: %s
desinst.fb.datoslocais = 🧭 Removing local Tao data (%s)…
desinst.fb.ok = \n✅ File Browser uninstalled.

desinst.lamp.card = 🌐 Uninstall LAMP
desinst.lamp.desc = Removes Apache, MariaDB and PHP from this server, including all MySQL/MariaDB databases. Does not touch File Browser or its data.
desinst.lamp.btn = 🌐 Uninstall LAMP
desinst.lamp.confirm = This will uninstall Apache, MariaDB and PHP, including ALL databases. It cannot be undone. Continue?
desinst.lamp.erroplaybook = ❌ Playbook not found: %s
desinst.lamp.log.iniciando = 🌐 Uninstalling LAMP…\n
desinst.lamp.erro = \n❌ Error: %s
desinst.lamp.ok = \n✅ LAMP uninstalled.
