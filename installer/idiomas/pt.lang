# ── Zona de perigo: desinstalação ────────────────────────────────────
desinst.titulo = ⚠️  Zona de perigo
desinst.intro = Estas ações desfazem a instalação e não podem ser revertidas. Cada uma é independente: podes desinstalar só o File Browser ou só o LAMP sem tocar no resto do Piztu.
desinst.confirmar.label = Escreve %s para confirmar

desinst.piztu.card = 🗑️  Desinstalar o Piztu completo
desinst.piztu.desc = Remove /opt/piztu (configuração, base de dados de posições, histórico…), o salt-master e as suas chaves, o serviço de histórico de sessões, a regra sudoers e a chave SSH configurada, os dados locais do Tao (~/.config/dixitalizacion) e os atalhos e o ícone. NÃO toca no LAMP nem no File Browser: desinstala-os à parte se também os quiseres remover.
desinst.piztu.palabra = DESINSTALAR
desinst.piztu.btn = 🗑️  Desinstalar o Piztu completo
desinst.piztu.confirm = Isto vai remover o Piztu por completo deste servidor, incluindo a base de dados de posições e o histórico. Não pode ser desfeito. Continuar?
desinst.piztu.erro = \n❌ Erro: %s
desinst.piztu.ok = \n✅ Piztu desinstalado por completo.

desinst.fb.card = 📁 Desinstalar o File Browser
desinst.fb.desc = Remove o serviço, o binário e a configuração do File Browser, TODOS os dados do servidor (/var/www/html/arquivos: trabalhos e certificados dos alunos, histórico de sessões, matérias, tarefas, práticas, mensagens…) e os dados locais do Tao deste equipamento (~/.config/dixitalizacion). Não se conserva nada.
desinst.fb.btn = 📁 Desinstalar o File Browser
desinst.fb.confirm = Isto vai desinstalar o File Browser e APAGAR todos os seus dados: os trabalhos e certificados dos alunos (/var/www/html/arquivos), o histórico de sessões, as matérias, tarefas e práticas, e os dados locais do Tao deste equipamento (~/.config/dixitalizacion). NÃO se pode desfazer. Continuar?
desinst.fb.erroplaybook = ❌ Playbook não encontrado: %s
desinst.fb.log.iniciando = 📁 A desinstalar o File Browser…\n
desinst.fb.erro = \n❌ Erro: %s
desinst.fb.datoslocais = 🧭 A eliminar os dados locais do Tao (%s)…
desinst.fb.ok = \n✅ File Browser desinstalado.

desinst.lamp.card = 🌐 Desinstalar o LAMP
desinst.lamp.desc = Remove o Apache, o MariaDB e o PHP deste servidor, incluindo todas as bases de dados de MySQL/MariaDB. Não toca no File Browser nem nos seus dados.
desinst.lamp.btn = 🌐 Desinstalar o LAMP
desinst.lamp.confirm = Isto vai desinstalar o Apache, o MariaDB e o PHP, incluindo TODAS as bases de dados. Não pode ser desfeito. Continuar?
