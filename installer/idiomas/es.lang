# ── Zona de peligro: desinstalación ──────────────────────────────────
desinst.titulo = ⚠️  Zona de peligro
desinst.intro = Estas acciones deshacen la instalación y no se pueden revertir. Cada una es independiente: puedes desinstalar solo File Browser o solo LAMP sin tocar el resto de Piztu.
desinst.confirmar.label = Escribe %s para confirmar

desinst.piztu.card = 🗑️  Desinstalar Piztu completo
desinst.piztu.desc = Elimina /opt/piztu (configuración, base de datos de posiciones, historial…), salt-master y sus claves, el servicio de historial de sesiones, la regla sudoers y la clave SSH configurada, los datos locales de Tao (~/.config/dixitalizacion) y los accesos directos y el icono. NO toca LAMP ni File Browser: desinstálalos aparte si también quieres eliminarlos.
desinst.piztu.palabra = DESINSTALAR
desinst.piztu.btn = 🗑️  Desinstalar Piztu completo
desinst.piztu.confirm = Esto va a eliminar Piztu por completo de este servidor, incluida la base de datos de posiciones y el historial. No se puede deshacer. ¿Continuar?
desinst.piztu.erro = \n❌ Error: %s
desinst.piztu.ok = \n✅ Piztu desinstalado completamente.

desinst.fb.card = 📁 Desinstalar File Browser
desinst.fb.desc = Elimina el servicio, el binario y la configuración de File Browser, TODOS los datos del servidor (/var/www/html/arquivos: trabajos y certificados del alumnado, historial de sesiones, materias, tareas, prácticas, mensajes…) y los datos locales de Tao de este equipo (~/.config/dixitalizacion). No se conserva nada.
desinst.fb.btn = 📁 Desinstalar File Browser
desinst.fb.confirm = Esto va a desinstalar File Browser y BORRAR todos sus datos: los trabajos y certificados del alumnado (/var/www/html/arquivos), el historial de sesiones, las materias, tareas y prácticas, y los datos locales de Tao de este equipo (~/.config/dixitalizacion). NO se puede deshacer. ¿Continuar?
desinst.fb.erroplaybook = ❌ Playbook no encontrado: %s
desinst.fb.log.iniciando = 📁 Desinstalando File Browser…\n
desinst.fb.erro = \n❌ Error: %s
desinst.fb.datoslocais = 🧭 Eliminando los datos locales de Tao (%s)…
desinst.fb.ok = \n✅ File Browser desinstalado.

desinst.lamp.card = 🌐 Desinstalar LAMP
desinst.lamp.desc = Elimina Apache, MariaDB y PHP de este servidor, incluidas todas las bases de datos de MySQL/MariaDB. No toca File Browser ni sus datos.
desinst.lamp.btn = 🌐 Desinstalar LAMP
desinst.lamp.confirm = Esto va a desinstalar Apache, MariaDB y PHP, incluidas TODAS las bases de datos. No se puede deshacer. ¿Continuar?
desinst.lamp.erroplaybook = ❌ Playbook no encontrado: %s
